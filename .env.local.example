# ─────────────────────────────────────────────────────────────────────────────
# Supabase
# Găsești aceste valori în Supabase Dashboard → Settings → API
# ─────────────────────────────────────────────────────────────────────────────

# URL-ul proiectului tău Supabase (public)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxx.supabase.co

# Anon key (public — safe to expose in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key (PRIVAT — nu expune niciodată în client)
# Folosit doar în Server Actions și funcții server-side
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─────────────────────────────────────────────────────────────────────────────
# Resend (email)
# Creează cont la resend.com, obți API key din Settings → API Keys
# ─────────────────────────────────────────────────────────────────────────────

# API key Resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Adresa de email la care primești notificările (admin-ul tău)
ADMIN_EMAIL=admin@example.com

# ─────────────────────────────────────────────────────────────────────────────
# Stripe (card payments)
# Chei din Stripe Dashboard → Developers → API keys (sandbox = "test mode")
# ─────────────────────────────────────────────────────────────────────────────

# Secret key (PRIVAT — doar server-side) — Stripe Dashboard → Developers → API keys
STRIPE_SECRET_KEY=paste-your-stripe-secret-key-here

# Publishable key (public — safe to expose in browser)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=paste-your-stripe-publishable-key-here

# Webhook signing secret — din `stripe listen` local sau Dashboard → Webhooks
# după ce ai înregistrat endpoint-ul /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=paste-your-stripe-webhook-signing-secret-here

# ─────────────────────────────────────────────────────────────────────────────
# Google Places API (recenziile Google de pe homepage)
# Google Cloud Console → APIs & Services → activează "Places API (New)" →
# Credentials → API key, restricționată la Places API (New). Doar server-side.
# Place ID-ul magazinului se pune în lib/store-info.ts → googlePlaceId.
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=paste-your-google-places-api-key-here
